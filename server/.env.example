# Copy to .env and fill in. NEVER commit .env
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/trustvault"
# Generate with: openssl rand -hex 32   (must be at least 32 characters)
JWT_SECRET="replace-me-with-a-long-random-string"
CLIENT_ORIGIN="http://localhost:5173"
PORT=4000
# Optional: where uploaded files live (must be a PRIVATE folder, never served publicly)
# STORAGE_DIR="./storage"
